{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meridian",
  "version": "../package.json",
  "identifier": "com.meridian.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meridian",
        "create": false,
        "width": 360,
        "height": 470,
        "minWidth": 110,
        "minHeight": 38,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Phyo Thiha Kyaw",
    "copyright": "© 2026 Phyo Thiha Kyaw",
    "shortDescription": "A lightweight always-on-top world clock widget.",
    "longDescription": "Meridian is a lightweight always-on-top world clock for Windows with timezone tracking, meeting reminders and Google Calendar sync.",
    "windows": {
      "wix": {
        "upgradeCode": "1f677b65-1e60-57c5-adbe-3f670e65a5b2"
      },
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRTdEOTQ5MTAzMTRDNApSV1RFRkFPUmxIMHVEQ25MWlJ6MGtDVC9kNmVlcDFQQ05FQms2SnZRUTBGa1ViK0xvYlp4V25STAo=",
      "endpoints": [
        "https://github.com/PTHK0805/world-clock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
